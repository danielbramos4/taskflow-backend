# Copie para .env somente se ele ainda nao existir; preserve os segredos atuais.
# Preencha localmente com a senha atual do banco, nunca com a senha de exemplo.
# Django e Compose: variaveis do processo prevalecem sobre o .env.
# No PowerShell, $env:VAR vale para a sessao; o .env persiste entre terminais.
# Uma variavel herdada desatualizada pode ser removida apenas da sessao.

# PostgreSQL - Desenvolvimento local
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=substituir_por_senha_local

# Django - Desenvolvimento local
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=substituir_por_chave_segura

# Conexao do Django executado no Windows
DB_HOST=127.0.0.1
DB_PORT=5434