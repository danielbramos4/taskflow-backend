# PostgreSQL - Desenvolvimento local
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=substituir_por_senha_local

# Django - Configuracao futura
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=substituir_por_chave_segura

# Conexao do Django executado no Windows
DB_HOST=127.0.0.1
DB_PORT=5434